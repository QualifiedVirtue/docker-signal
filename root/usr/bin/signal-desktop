#! /bin/bash

BIN=/usr/bin/signal-desktop-real

# Refuse to launch if the installed Signal files no longer match the package
# manager's records (e.g. replaced by an init script or mod after the build).
# Set SIGNAL_SKIP_VERIFY=true to bypass.
if [ "${SIGNAL_SKIP_VERIFY,,}" != "true" ]; then
  if command -v dpkg >/dev/null 2>&1; then
    # docs/man/locale files are excluded from install by the base image's dpkg config
    VERIFY_OUT=$(dpkg --verify signal-desktop 2>&1 \
      | grep -Ev '^missing +(c +)?/usr/share/(doc|man|info|lintian|locale)/')
  else
    VERIFY_OUT="dpkg not found; cannot verify signal-desktop"
  fi
  if [ -n "${VERIFY_OUT}" ]; then
    echo "[signal-desktop] package verification FAILED, not launching:" >&2
    echo "${VERIFY_OUT}" >&2
    exit 1
  fi
fi

# Wayland check
if [ "${PIXELFLUX_WAYLAND,,}" == "true" ]; then
  WAYLAND="--ozone-platform=wayland"
fi

# The Chromium sandbox is on by default (setuid chrome-sandbox).
# Set SIGNAL_NO_SANDBOX=true if your runtime cannot support it.
if [ "${SIGNAL_NO_SANDBOX,,}" == "true" ]; then
  SANDBOX="--no-sandbox"
fi

# EXTRA_ARGS is deliberately unquoted so multiple flags split into argv entries.
${BIN} ${WAYLAND} ${SANDBOX} ${EXTRA_ARGS} "$@"
